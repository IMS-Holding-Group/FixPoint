# الخادم: منفذ التشغيل وبيئة التشغيل (development أو production)
PORT=3000
NODE_ENV=development

# قاعدة البيانات: اتصال التطبيق بمستخدم MySQL محدود الصلاحيات
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fixpoint
DB_USER=fixpoint_app
DB_PASSWORD=

# قاعدة البيانات: حساب المسؤول المستخدم في أمر npm run db:init فقط
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# الجلسات: مفتاح سري عشوائي لحماية معرفات الجلسات (64 خانة على الأقل)
SESSION_SECRET=

# Google Maps: مفتاح JavaScript API لخريطة موقع العطل
GOOGLE_MAPS_API_KEY=

# CORS: النطاقات الموثوقة مفصولة بفواصل، وHTTPS كامل دون مسار في الإنتاج
ALLOWED_ORIGINS=http://localhost:3000